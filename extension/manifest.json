{
  "manifest_version": 3,
  "name": "Take File Manager",
  "short_name": "TFM",
  "version": "0.1.0",
  "key": "",
  "description": "Integrasi browser resmi Take File Manager — akselerasi unduhan multi-segmen, penangkap media HLS/DASH, dan torrent magnet.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "webRequest",
    "cookies",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Take File Manager",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_magnet.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_video.js"],
      "run_at": "document_idle"
    }
  ]
}
